{
  "version": 2,
  "installCommand": "npm ci --prefix backend && npm ci --include=dev --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/public/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/assets/:path*", "destination": "/api/index" }
  ]
}
